# ─── OceanLearn Backend — Variables de Entorno ────────────────────────────────
# Copia este archivo como .env y completa los valores

# Flask
FLASK_DEBUG=true
SECRET_KEY=cambia-este-valor-por-algo-aleatorio-largo

# JWT
JWT_SECRET_KEY=otro-secreto-diferente-al-anterior
JWT_ACCESS_HOURS=8
JWT_REFRESH_DAYS=30

# Base de datos
# SQLite (desarrollo local — no requiere instalación)
DATABASE_URL=sqlite:///oceanlearn.db

# PostgreSQL (producción — descomentar y completar)
# DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/oceanlearn

# CORS — orígenes permitidos separados por coma
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Carpeta para subida de fotos
UPLOAD_FOLDER=uploads
